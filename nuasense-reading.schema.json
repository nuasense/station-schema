{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nuasense/station-schema/nuasense-reading.schema.json",
  "title": "NuaSense reading",
  "description": "One reading from one station: weather, soil, water, greenhouse, livestock housing, beehive, storage, transport, air and energy along an agricultural chain. Names and units are fixed; a field that is not listed is refused. At most 40 values per reading. Generated from the receiver's vocabulary by node-back-end/scripts/build_reading_schema.js.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339. Required in the JSON API (POST /api/nuasense/v1/ingest/readings); ignored on a push path, where the receive time is the reading's time."
    },
    "device_id": {
      "type": "string",
      "maxLength": 48,
      "description": "Push path only: any name for the device. Binds the station's token to it, so a second device cannot use the same address."
    },
    "software": {
      "type": "string",
      "maxLength": 48,
      "description": "Push path only: the firmware or library that sent the reading, e.g. nuasense-arduino/0.1.0."
    },
    "temperature": {
      "type": "number",
      "minimum": -90,
      "maximum": 60,
      "description": "°C"
    },
    "humidity": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "%"
    },
    "pressure": {
      "type": "number",
      "minimum": 300,
      "maximum": 1100,
      "description": "hPa"
    },
    "light": {
      "type": "number",
      "minimum": 0,
      "maximum": 200000,
      "description": "lux"
    },
    "wind_speed": {
      "type": "number",
      "minimum": 0,
      "maximum": 120,
      "description": "m/s"
    },
    "wind_gusts": {
      "type": "number",
      "minimum": 0,
      "maximum": 150,
      "description": "m/s"
    },
    "wind_direction": {
      "type": "number",
      "minimum": 0,
      "maximum": 360,
      "description": "°"
    },
    "rain_pulses": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000,
      "description": "count"
    },
    "rain_mm": {
      "type": "number",
      "minimum": 0,
      "maximum": 300,
      "description": "mm"
    },
    "uv_index": {
      "type": "number",
      "minimum": 0,
      "maximum": 20,
      "description": "index"
    },
    "leaf_wetness": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "%; several sensors: leaf_wetness_2 … leaf_wetness_8"
    },
    "soil_moisture": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "% vol; several sensors: soil_moisture_2 … soil_moisture_8"
    },
    "soil_temperature": {
      "type": "number",
      "minimum": -30,
      "maximum": 80,
      "description": "°C; several sensors: soil_temperature_2 … soil_temperature_8"
    },
    "soil_ec": {
      "type": "number",
      "minimum": 0,
      "maximum": 50,
      "description": "mS/cm; several sensors: soil_ec_2 … soil_ec_8"
    },
    "soil_tension": {
      "type": "number",
      "minimum": 0,
      "maximum": 2000,
      "description": "kPa; several sensors: soil_tension_2 … soil_tension_8"
    },
    "soil_ph": {
      "type": "number",
      "minimum": 0,
      "maximum": 14,
      "description": "pH; several sensors: soil_ph_2 … soil_ph_8"
    },
    "probe_temperature": {
      "type": "number",
      "minimum": -40,
      "maximum": 100,
      "description": "°C; several sensors: probe_temperature_2 … probe_temperature_8"
    },
    "water_level": {
      "type": "number",
      "minimum": -10,
      "maximum": 1000,
      "description": "m; several sensors: water_level_2 … water_level_8"
    },
    "water_temperature": {
      "type": "number",
      "minimum": -5,
      "maximum": 60,
      "description": "°C; several sensors: water_temperature_2 … water_temperature_8"
    },
    "water_ec": {
      "type": "number",
      "minimum": 0,
      "maximum": 200,
      "description": "mS/cm; several sensors: water_ec_2 … water_ec_8"
    },
    "water_ph": {
      "type": "number",
      "minimum": 0,
      "maximum": 14,
      "description": "pH; several sensors: water_ph_2 … water_ph_8"
    },
    "dissolved_oxygen": {
      "type": "number",
      "minimum": 0,
      "maximum": 30,
      "description": "mg/L; several sensors: dissolved_oxygen_2 … dissolved_oxygen_8"
    },
    "turbidity": {
      "type": "number",
      "minimum": 0,
      "maximum": 5000,
      "description": "NTU; several sensors: turbidity_2 … turbidity_8"
    },
    "flow_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000,
      "description": "L/min; several sensors: flow_rate_2 … flow_rate_8"
    },
    "water_pressure": {
      "type": "number",
      "minimum": 0,
      "maximum": 50,
      "description": "bar; several sensors: water_pressure_2 … water_pressure_8"
    },
    "greenhouse_temperature": {
      "type": "number",
      "minimum": -20,
      "maximum": 70,
      "description": "°C; several sensors: greenhouse_temperature_2 … greenhouse_temperature_8"
    },
    "greenhouse_humidity": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "%; several sensors: greenhouse_humidity_2 … greenhouse_humidity_8"
    },
    "co2": {
      "type": "number",
      "minimum": 100,
      "maximum": 10000,
      "description": "ppm; several sensors: co2_2 … co2_8"
    },
    "par": {
      "type": "number",
      "minimum": 0,
      "maximum": 3000,
      "description": "µmol/m²/s; several sensors: par_2 … par_8"
    },
    "leaf_temperature": {
      "type": "number",
      "minimum": -30,
      "maximum": 70,
      "description": "°C; several sensors: leaf_temperature_2 … leaf_temperature_8"
    },
    "stem_diameter": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000,
      "description": "µm; several sensors: stem_diameter_2 … stem_diameter_8"
    },
    "ammonia": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000,
      "description": "ppm; several sensors: ammonia_2 … ammonia_8"
    },
    "hive_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 500,
      "description": "kg; several sensors: hive_weight_2 … hive_weight_8"
    },
    "hive_temperature": {
      "type": "number",
      "minimum": -30,
      "maximum": 70,
      "description": "°C; several sensors: hive_temperature_2 … hive_temperature_8"
    },
    "hive_humidity": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "%; several sensors: hive_humidity_2 … hive_humidity_8"
    },
    "storage_temperature": {
      "type": "number",
      "minimum": -50,
      "maximum": 60,
      "description": "°C; several sensors: storage_temperature_2 … storage_temperature_8"
    },
    "storage_humidity": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "%; several sensors: storage_humidity_2 … storage_humidity_8"
    },
    "ethylene": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000,
      "description": "ppm; several sensors: ethylene_2 … ethylene_8"
    },
    "grain_moisture": {
      "type": "number",
      "minimum": 0,
      "maximum": 60,
      "description": "%; several sensors: grain_moisture_2 … grain_moisture_8"
    },
    "grain_temperature": {
      "type": "number",
      "minimum": -30,
      "maximum": 90,
      "description": "°C; several sensors: grain_temperature_2 … grain_temperature_8"
    },
    "door_open": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "0/1; several sensors: door_open_2 … door_open_8"
    },
    "gps_latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "°"
    },
    "gps_longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "°"
    },
    "gps_speed": {
      "type": "number",
      "minimum": 0,
      "maximum": 300,
      "description": "km/h"
    },
    "pm1": {
      "type": "number",
      "minimum": 0,
      "maximum": 2000,
      "description": "µg/m³; several sensors: pm1_2 … pm1_8"
    },
    "pm25": {
      "type": "number",
      "minimum": 0,
      "maximum": 2000,
      "description": "µg/m³; several sensors: pm25_2 … pm25_8"
    },
    "pm10": {
      "type": "number",
      "minimum": 0,
      "maximum": 2000,
      "description": "µg/m³; several sensors: pm10_2 … pm10_8"
    },
    "voc_index": {
      "type": "number",
      "minimum": 0,
      "maximum": 500,
      "description": "index; several sensors: voc_index_2 … voc_index_8"
    },
    "battery_voltage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "V"
    },
    "battery_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "%"
    },
    "power": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000000,
      "description": "W; several sensors: power_2 … power_8"
    },
    "pv_power": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000000,
      "description": "W; several sensors: pv_power_2 … pv_power_8"
    }
  },
  "patternProperties": {
    "^leaf_wetness_[1-8]$": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "%, channel 1–8"
    },
    "^soil_moisture_[1-8]$": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "% vol, channel 1–8"
    },
